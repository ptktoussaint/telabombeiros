# Banco de dados (MongoDB Atlas)
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/telabombeiros

# Segredo do cookie de sessao (troque por um valor longo e aleatorio)
SESSION_SECRET=troque-este-valor

# Acesso do administrador
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
# Alternativa mais segura: hash bcrypt da senha (tem prioridade sobre ADMIN_PASSWORD)
# ADMIN_PASSWORD_HASH=

# URL publica do site (usada para montar os links de convite)
PUBLIC_URL=https://seu-app.onrender.com

# STUN/TURN
STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:seu-turn.exemplo.com:3478,turns:seu-turn.exemplo.com:5349
# Opcao 1 - credencial efemera HMAC (coturn "use-auth-secret")
# TURN_SECRET=
# TURN_TTL=3600
# Opcao 2 - usuario/senha fixos (Open Relay, Metered, etc.)
# TURN_USERNAME=
# TURN_CREDENTIAL=

PORT=3000
